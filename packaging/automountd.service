[Unit]
Description=automountd — Linux disk auto-mount service
Documentation=file:/usr/local/share/doc/automountd/README.md
After=local-fs.target systemd-udevd.service
Wants=systemd-udevd.service
ConditionPathIsDirectory=/sys/class/block
# The control socket lives in /run
RequiresMountsFor=/media /run

[Service]
Type=simple
ExecStart=/usr/local/bin/automountd daemon
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=15

# Logs go to journald: journalctl -u automountd -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=automountd

# ---- Hardening ----
# No privilege escalation is needed (it already runs as root); forbid child processes from gaining privileges
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Needs AF_UNIX (control socket) and AF_NETLINK (udevadm monitor)
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# The kernel may load ntfs3/exfat and similar modules on demand, so ProtectKernelModules is left off

[Install]
WantedBy=multi-user.target
